{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Primer",
  "version": "2.0.0",
  "identifier": "za.co.horizon.primer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:8734",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Primer",
        "width": 1440,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/"
    ],
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pcap"],
        "name": "Packet capture",
        "description": "Primer packet capture",
        "role": "Editor"
      },
      {
        "ext": ["pcapng"],
        "name": "Packet capture NG",
        "description": "Primer pcapng capture",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
